# 数据库（SQLite 本地文件）
DATABASE_URL=sqlite+aiosqlite:///./data/stock_analyzer.db

# 爬取限流
CRAWL_MAX_QPS=2.0
CRAWL_BURST=5

# 爬取 HTTP 超时（秒）与代理（按需取消注释）
CRAWL_REQUEST_TIMEOUT=30
# HTTP 代理示例:
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# SOCKS5 代理示例（需 pip install "requests[socks]"）:
# HTTP_PROXY=socks5h://127.0.0.1:9909
# HTTPS_PROXY=socks5h://127.0.0.1:9909

# 日志级别
LOG_LEVEL=INFO

# 启用深度学习预测策略（需 pip install -e ".[ml]"）
ENABLE_ML_STRATEGIES=false

# LSTM 强化参数（lstm-v2：多特征 + 验证早停）
LSTM_LOOKBACK=30
LSTM_MAX_EPOCHS=100
LSTM_HIDDEN_SIZE=64
LSTM_PATIENCE=10

# Web 自选股与实时爬取
WATCHLIST_PATH=./data/watchlist.json
REALTIME_INTERVAL_SECONDS=60
REALTIME_INCREMENTAL_DAYS=7
